# RESQ-AI Default Environment
# To enable real Firebase, fill in your project credentials below.
# By default, RESQ-AI operates in zero-setup Local Reactive Mode for instant judge demo!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API Key (Optional)
VITE_GEMINI_API_KEY=
