# ==========================================
# RESQ-AI ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# 1. Firebase Cloud Firestore (Optional)
# If provided, RESQ-AI connects to Cloud Firestore.
# If omitted or empty, RESQ-AI automatically activates its resilient local reactive bus
# with zero configuration, allowing 100% demo functionality immediately out of the box!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2. Generative AI API (Optional)
# If provided, RESQ-AI uses Gemini 1.5 Flash for Layer-2 emergency text classification.
# If omitted, RESQ-AI uses its deterministic Layer-1 rule-based NLP classification matrix.
VITE_GEMINI_API_KEY=
